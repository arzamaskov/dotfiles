        },
        {
            "id": "User.FocusPaneUp",
            "keys": "alt+k"
        },
        {
            "id": "User.FocusPaneRight",
            "keys": "alt+l"
        },
        {
            "id": "User.DuplicatePaneDown30",
            "keys": "alt+shift+s"
        },
        {
            "id": "User.FocusPaneLeft",
            "keys": "alt+h"
        },
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+shift+c"
        },
        {
            "id": "User.FocusPaneDown",
            "keys": "alt+j"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+shift+v"
        }
    ],
    "language": "en-US",
    "launchMode": "maximized",
