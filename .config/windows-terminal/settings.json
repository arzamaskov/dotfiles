{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": 
    [
        {
            "command": 
            {
                "action": "splitPane",
                "size": 0.3,
                "split": "right",
                "splitMode": "duplicate"
            },
            "id": "User.DuplicatePaneRight45",
            "name": "Duplicate pane right (30%)"
        },
        {
            "command": 
            {
                "action": "splitPane",
                "size": 0.3,
                "split": "down",
                "splitMode": "duplicate"
            },
            "id": "User.DuplicatePaneDown30",
            "name": "Duplicate pane down (30%)"
        },
        {
            "command": 
            {
                "action": "moveFocus",
                "direction": "down"
            },
            "id": "User.FocusPaneDown",
            "name": "Focus pane down"
        },
        {
            "command": 
            {
                "action": "moveFocus",
                "direction": "left"
            },
            "id": "User.FocusPaneLeft",
            "name": "Focus pane left"
        },
        {
            "command": 
            {
                "action": "moveFocus",
                "direction": "up"
            },
            "id": "User.FocusPaneUp",
            "name": "Focus pane up"
        },
        {
            "command": 
            {
                "action": "moveFocus",
                "direction": "right"
            },
            "id": "User.FocusPaneRight",
            "name": "Focus pane right"
        }
    ],
    "alwaysShowNotificationIcon": false,
    "copyFormatting": "none",
    "copyOnSelect": true,
    "defaultInputScope": "alphanumericHalfWidth",
    "defaultProfile": "{216fb6fa-7282-5a5c-933c-d74442748e9d}",
    "disabledProfileSources": 
    [
        "Windows.Terminal.Azure",
        "Windows.Terminal.VisualStudio"
    ],
