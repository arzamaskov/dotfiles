# Font
font-family = "FiraCode Nerd Font"
font-size = 14

# Theme
theme = tokyonight
background = #222436

# Cursor
cursor-style = block
cursor-style-blink = true
cursor-color = #63e352
cursor-text = #222436
# Не превращать курсор в bar на shell prompt
shell-integration-features = no-cursor

# Keybindings
keybind = ctrl+z=close_surface
keybind = cmd+/=new_split:down
keybind = chain=resize_split:down,80
keybind = ctrl+d=unbind

# Window
macos-titlebar-style = transparent
maximize = true
quit-after-last-window-closed = true

window-padding-x = 3
window-padding-y = 2,1
window-padding-balance = false
