# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
# background = 282c34
# foreground = ffffff

# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

keybind = ctrl+z=close_surface
keybind = cmd+/=new_split:down
keybind = chain=resize_split:down,80
keybind = ctrl+d=unbind

# Empty values reset the configuration to the default value
font-family = "FiraCode Nerd Font"
# font-family = "JetBrainsMono Nerd Font"
font-size = 14

# theme = Apple System Colors Light
# theme = Alabaster
# theme = Solarized Dark Higher Contrast
# theme = Builtin Solarized Dark
# theme = Flexoki Light
# theme = TokyoNight Moon
# theme = Rose Pine Moon
theme = GitHub Light Default

cursor-style = block
cursor-style-blink = false
cursor-color = #24292f
cursor-text = #ffffff

